# Linux/vServer example. Copy to .env and adjust the host directories.
PARSEC_SEARCH_DATA_PATH=/opt/parsec-search/data
PARSEC_SEARCH_MODEL_PATH=/opt/parsec-search/models

# Shared only between the Gateway and Search service for embedding ingestion.
PARSEC_SEARCH_INTERNAL_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
PARSEC_SEARCH_EMBEDDING_MODEL_ID=laion-clap-630k-audioset-v1
PARSEC_SEARCH_EMBEDDING_VERSION=1
